{
  "name": "tsunagiai",
  "private": true,
  "scripts": {
    "tauri": "tauri",
    "build:ts": "tsc -p ts/tsconfig.json",
    "watch:ts": "tsc -p ts/tsconfig.json --watch --preserveWatchOutput",
    "vendor:milkdown": "node scripts/build-milkdown.mjs",
    "vendor:codemirror": "node scripts/build-codemirror.mjs",
    "e2e:build": "npm run build:ts && node e2e/assemble.mjs && tauri build --debug --no-bundle --features e2e --config src-tauri/tauri.e2e.conf.json",
    "e2e": "wdio run wdio.conf.ts",
    "lint": "biome lint .",
    "e2e:check": "tsc --noEmit -p e2e/tsconfig.json"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-less": "^6.0.2",
    "@codemirror/lang-liquid": "^6.3.3",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sass": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-vue": "^0.1.3",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@milkdown/kit": "^7.23.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.6",
    "@wdio/cli": "^10.2.0",
    "@wdio/local-runner": "^10.2.0",
    "@wdio/mocha-framework": "^10.2.0",
    "@wdio/spec-reporter": "^10.2.0",
    "@wdio/tauri-plugin": "^1.5.1",
    "@wdio/tauri-service": "^1.5.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "webdriverio": "^10.2.0"
  }
}
